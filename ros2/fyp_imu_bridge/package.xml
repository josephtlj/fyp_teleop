<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fyp_imu_bridge</name>
  <version>0.1.0</version>
  <description>Publishes the FYP-IMU boards' orientation, received from host/imu_ble_bridge.py over UDP, as ROS2 topics.</description>
  <maintainer email="167979343+josephtlj@users.noreply.github.com">Joseph</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
